@inherits LayoutComponentBase

<div class="container-fluid p-0">
    <div class="bg-black min-vh-100 p-0 px-4 m-0 d-flex flex-column">
        <header class="bg-black text-light header-padding">
            <HeaderContent />
        </header>

        <main class="bg-white rounded-5 flex-fill overflow-auto">
            <article class="content p-4">
                @Body
            </article>
        </main>

        <footer>
            <FooterContent />
        </footer>
    </div>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
