@implements IDisposable
@inject SharedTextService SharedText

<div class="row py-3">
    <div class="col-8 text-start">
        <button class="btn m-0 p-0">
            <a href="/">
                <img src="images/logo.svg" 
                        class="rounded-3 p-0 m-0 text-decoration-none d-inline"
                        style="width:30px; height:30px; border: 2px solid #f89b82;" />
                <span class="text-white align-middle ms-2 header-title">
                    @SharedText.Get("HeaderTitle")
                </span>
            </a>
        </button>
    </div>
    <div class="col-4 text-end">
        <button class="btn py-1" 
                @onclick="ChangeLanguage"
                style="background-color: #f89b82 !important; font-size: x-small; font-weight: bold;"
                title="@(SharedText.Get("LanguageButtonTitle"))" >
            <i class="bi bi-globe2 me-1"></i>
            <span class="align-middle">
                @(SelectedLanguage.LanguageDisplay())
            </span>
        </button>
    </div>
</div>



@code {
    [Inject]
    public IStateHandler? StateHandler { get; set; }

    [Inject]
    public IObjectStore? ObjectStore { get; set; }

    private Language SelectedLanguage { get; set; } = Language.Swedish;

    protected override void OnInitialized()
    {
        StateHandler!.OnChange += StateHasChanged;
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StateHandler!.InitializeAsync();
            SelectedLanguage = StateHandler.CurrentLanguage;
            StateHasChanged();
        }
    }

    public async Task ChangeLanguage()
    {
        switch (SelectedLanguage) 
        {
            case Language.Swedish:
                await StateHandler!.SelectLanguage(Language.English);
                break;
            case Language.English:
                await StateHandler!.SelectLanguage(Language.Swedish);
                break;
            default:
                await StateHandler!.SelectLanguage(Language.Swedish);
                break;
        }

        SelectedLanguage = StateHandler.CurrentLanguage;
    }


    public void Dispose() 
    {
        StateHandler!.OnChange -= StateHasChanged;
    }
}