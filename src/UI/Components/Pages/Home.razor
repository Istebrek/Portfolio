@rendermode InteractiveServer
@implements IDisposable
@page "/"



<PageTitle>Istebrek's Portfolio</PageTitle>
<div>
    @foreach(var summary in projectSummaries)
    {
        @summary.Description
        @summary.Id
    }
</div>

@code {
    [Inject]
    private IStateHandler? StateHandler { get; set; }

    [Inject]
    private IListHandler? ListHandler { get; set; }

    private List<ProjectSummaryDto> projectSummaries { get; set; } = [];

    protected override void OnInitialized()
    {
        StateHandler!.OnChange += StateHasChanged;
        ListHandler!.OnChange += SetLists;
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            SetLists();
            StateHasChanged();
        }
    }

    public void SetLists()
    {
        projectSummaries = ListHandler!.ProjectSummaries ?? [];
        StateHasChanged();
    }

    public void Dispose()
    {
        StateHandler!.OnChange -= StateHasChanged;
        ListHandler!.OnChange -= StateHasChanged;
    }
}